# Groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_TIMEOUT=120

# Local embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=research_docs

# Agent settings
MAX_SEARCH_RESULTS=5
MAX_RAG_RESULTS=5

# Code sandbox
CODE_SANDBOX_DIR=./.code_sandbox
CODE_SANDBOX_TIMEOUT=120
CODE_SANDBOX_PYTHON=

# Local datasets
DATASET_ROOT_DIR=./data
DATASET_UPLOAD_DIR=./data/uploads

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research-assistant
